# ── Asana credentials ────────────────────────────────────────────────────────
# Personal Access Token from https://app.asana.com/0/my-apps
ASANA_PAT=your_personal_access_token_here

# Project GID — found in the Asana project URL:
#   app.asana.com/0/<PROJECT_GID>/...
ASANA_PROJECT_GID=your_project_gid_here

# Section GIDs — open the project, right-click a section → Copy section link
# The GID is the number at the end of the URL
ASANA_SECTION_NEW_LEADS_GID=your_new_leads_section_gid_here
ASANA_SECTION_SCRIPT_REQUESTS_GID=your_script_requests_section_gid_here

# Assignees — Asana user GIDs (found via GET https://app.asana.com/api/1.0/users/me)
# Task assignee (primary) — receives the task
ASANA_ASSIGNEE_1_GID=first_user_gid_here
# Secondary team member — added as a follower so they're notified
ASANA_ASSIGNEE_2_GID=second_user_gid_here

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# Comma-separated list of allowed frontend origins, or * to allow all.
# Example: https://leadvirtual.com,https://www.leadvirtual.com
ALLOWED_ORIGIN=*
